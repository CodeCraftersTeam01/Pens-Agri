# ========================================================
# PENS AGRI PRESISI - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Salin file ini menjadi '.env' dan sesuaikan dengan kredensial sistem lokal Anda.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_pertanian
DB_PORT=3306

# Application Security & Session
SESSION_SECRET=your_secure_random_session_secret_key

# OpenAI Artificial Intelligence Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
