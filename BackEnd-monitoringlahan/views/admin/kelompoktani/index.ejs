<%- include('../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<div style="display: flex; min-height: 100vh;">
    <%- include('../../partials/_nav_admin.ejs') %>

    <div class="main-content">
        <%- include('../../partials/_top_nav_admin.ejs') %>

        <div class="page-content-wrapper">
            <div class="d-flex justify-content-between flex-wrap align-items-center mb-4 gap-3">
                <div>
                    <div class="page-header-eyebrow">
                        <i class="fa-solid fa-users"></i>
                        Master Kelembagaan
                    </div>
                    <h1 class="page-header-title">Data Kelompok Tani</h1>
                    <p class="page-header-sub">Daftar registrasi dan profil kelompok tani (Poktan / KTH) Kabupaten Sumenep</p>
                </div>
                <button class="btn-secondary" onclick="window.location.reload();">
                    <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                </button>
            </div>
        
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title">Daftar Registrasi Kelompok Tani (KTH)</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 13px; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px; text-align: center;">No</th>
                                <% if (typeof userRole !== 'undefined' && userRole == 1) { %>
                                    <th style="width: 60px; text-align: center;">Aksi</th>
                                <% } %>
                                <th>Nama Kelompok</th>
                                <th>No. Register</th>
                                <th style="text-align: center;">Tanggal Berdiri</th>
                                <th style="text-align: center;">Kelas</th>
                                <th>Alamat</th>
                                <th>Ketua</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (data && data.length > 0) { %>
                                <% for(var i = 0; i < data.length; i++) { %>
                                    <tr>
                                        <td class="text-center text-secondary fw-semibold font-monospace">#<%= (i + 1) %></td>
                                        <% if (typeof userRole !== 'undefined' && userRole == 1) { %>
                                            <td class="text-center">
                                                <a href="/kelompoktani/delete/<%= data[i].id %>" class="btn btn-sm btn-outline-danger py-0 px-2" style="border-radius: 4px; font-size: 11px;" onclick="return confirm('Apakah Anda yakin ingin menghapus kelompok tani ini?');">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </td>
                                        <% } %>
                                        <td class="fw-bold text-dark"><%= data[i].nama_kelompok %></td>
                                        <td><code><%= data[i].no_register %></code></td>
                                        <td class="text-center">
                                            <%= data[i].tanggal_berdiri ? new Date(data[i].tanggal_berdiri).toLocaleDateString('id-ID', { dateStyle: 'medium' }) : '–' %>
                                        </td>
                                        <td class="text-center">
                                            <span class="dev-badge"><%= data[i].kelas %></span>
                                        </td>
                                        <td style="white-space: normal; min-width: 250px;"><%= data[i].alamat %></td>
                                        <td class="fw-semibold"><%= data[i].ketua %></td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="<%= (typeof userRole !== 'undefined' && userRole == 1) ? 8 : 7 %>" class="text-center text-secondary py-4">
                                        <i class="fa-solid fa-database me-2"></i> Belum ada data kelompok tani di database.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
  $(document).ready(function() {
    $('table').DataTable({
      dom: 'Bfrtip',
      buttons: [
        'copy', 'csv', 'excel', 'pdf', 'print'
      ],
      pageLength: 10,
      responsive: true,
      ordering: true,
      language: {
        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json"
      }
    });
  });
</script>

<%- include('../../partials/_foot_admin.ejs') %>