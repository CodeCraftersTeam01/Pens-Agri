<%- include('../partials/_head_admin.ejs') %>

<div class="container-fluid">
    <div class="row">
        <%- include('../partials/_nav_admin.ejs') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 p-0">
            <%- include('../partials/_top_nav_admin.ejs') %>

            <div class="p-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-3">
                    <h1 class="h2 fw-bold text-navy">Ringkasan Analisis</h1>
                    <button class="btn btn-sm btn-navy shadow-sm" onclick="window.location.reload();">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                    </button>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-6 col-xl-3">
                        <div class="card card-custom p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small fw-semibold mb-1">Total Lahan Terdata</h6>
                                    <h3 class="mb-0 fw-bold text-navy">124</h3>
                                </div>
                                <div class="p-3 rounded-3 bg-light text-navy"><i class="fa-solid fa-map-marked-alt fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 col-xl-3">
                        <div class="card card-custom p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small fw-semibold mb-1">Rata-rata pH Tanah</h6>
                                    <h3 class="mb-0 fw-bold text-yellow">6.4</h3>
                                </div>
                                <div class="p-3 rounded-3 bg-light text-yellow"><i class="fa-solid fa-flask fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 col-xl-3">
                        <div class="card card-custom p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small fw-semibold mb-1">Rata-rata Nitrogen</h6>
                                    <h3 class="mb-0 fw-bold text-success">42 <span class="fs-6 fw-normal text-muted">mg/kg</span></h3>
                                </div>
                                <div class="p-3 rounded-3 bg-light text-success"><i class="fa-solid fa-leaf fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 col-xl-3">
                        <div class="card card-custom p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted small fw-semibold mb-1">Ketersediaan Irigasi</h6>
                                    <h3 class="mb-0 fw-bold text-info">85%</h3>
                                </div>
                                <div class="p-3 rounded-3 bg-light text-info"><i class="fa-solid fa-droplet fs-4"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-lg-8">
                        <div class="card card-custom p-3">
                            <h5 class="card-title mb-3 fw-bold text-navy">Identiifikasi Tren Unsur Hara (NPK)</h5>
                            <div style="height: 300px; position: relative;">
                                <canvas id="npkTrendChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card card-custom p-3">
                            <h5 class="card-title mb-3 fw-bold text-navy">Distribusi Komoditas Lahan</h5>
                            <div style="height: 300px; position: relative;">
                                <canvas id="commodityPieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-custom p-3">
                    <h5 class="card-title mb-3 fw-bold text-navy">Log Monitoring Lahan Terbaru</h5>
                    <div class="table-responsive">
                        <table class="table table-custom table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nama Desa</th>
                                    <th>Koordinat (Lat, Lon)</th>
                                    <th>Komoditas</th>
                                    <th>pH</th>
                                    <th>N (mg/kg)</th>
                                    <th>P (mg/kg)</th>
                                    <th>K (mg/kg)</th>
                                    <th>Irigasi</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#1024</td>
                                    <td class="fw-semibold text-navy">Aeng Tong-Tong</td>
                                    <td><small class="font-monospace text-muted">-7.0124, 113.8543</small></td>
                                    <td><span class="badge bg-success bg-opacity-10 text-success border border-success">Jagung</span></td>
                                    <td class="fw-bold text-yellow">6.5</td>
                                    <td>45</td>
                                    <td>32</td>
                                    <td>58</td>
                                    <td><span class="badge bg-success">Ya</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-navy"><i class="fa-solid fa-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>#1023</td>
                                    <td class="fw-semibold text-navy">Bluto</td>
                                    <td><small class="font-monospace text-muted">-7.0432, 113.8765</small></td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary">Padi</span></td>
                                    <td class="fw-bold text-yellow">6.1</td>
                                    <td>38</td>
                                    <td>29</td>
                                    <td>62</td>
                                    <td><span class="badge bg-success">Ya</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-navy"><i class="fa-solid fa-eye"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>


<%- include('../partials/_foot_admin.ejs') %>





