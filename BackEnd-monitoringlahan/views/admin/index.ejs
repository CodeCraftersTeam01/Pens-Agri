<%- include('../partials/_foot_admin.ejs') %>

<!-- Chart Initialization Scripts -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Dual Bar Chart: Dashboard Activity & Production
        const actCtx = document.getElementById('dashboardActivityChart');
        if (actCtx) {
            new Chart(actCtx, {
                type: 'bar',
                data: {
                    labels: ['Sab', 'Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum'],
                    datasets: [
                        {
                            label: 'Aktivitas Lahan (Jam)',
                            data: [18, 14, 22, 16, 24, 12, 20],
                            backgroundColor: '#2563eb',
                            borderRadius: 6,
                            barThickness: 12,
                        },
                        {
                            label: 'Produksi (kg)',
                            data: [12, 18, 15, 20, 18, 22, 14],
                            backgroundColor: '#f59e0b',
                            borderRadius: 6,
                            barThickness: 12,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0b1c33',
                            titleFont: { size: 12, weight: 'bold' },
                            bodyFont: { size: 11 },
                            cornerRadius: 8,
                            padding: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#94a3b8', font: { size: 11, weight: '500' } }
                        },
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });
        }

        // Commodity Doughnut Chart
        const pieCtx = document.getElementById('commodityPieChart');
        if (pieCtx) {
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Padi', 'Cabai', 'Jagung', 'Tembakau'],
                    datasets: [{
                        data: [45, 25, 18, 12],
                        backgroundColor: ['#16a34a', '#ef4444', '#f59e0b', '#2563eb'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 10,
                                font: { size: 11 }
                            }
                        }
                    },
                    cutout: '68%'
                }
            });
        }
    });
</script>
