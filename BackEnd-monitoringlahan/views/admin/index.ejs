                                    <div class="d-flex align-items-center gap-2.5">
                                        <div style="width: 34px; height: 34px; border-radius: 8px; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 13px;">
                                            <i class="fa-solid fa-users"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 12.5px;">Rapat Koordinasi Kelompok Tani</div>
