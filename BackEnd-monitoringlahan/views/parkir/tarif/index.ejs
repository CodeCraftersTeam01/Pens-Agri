<%- include('../../partials/_head_admin.ejs') %>

<div class="container">
    <div class="row">
        
        <div class="col mx-4">
           <h2>Tarif Page</h2>
           <p><%= email %></p>
           <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
        Tambah Tarif
        </button>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <table class="table">
            <thead>
                <tr>
                <th scope="col">#</th>
                <th scope="col">Jenis</th>
                <th scope="col">Tarif</th>
                <th scope="col">Waktu</th>
                <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                <% for(var i = 0; i < data.length; i++){ %>
                    <tr>
                        <th scope="row"><%= (i+1) %></th>
                        <td><%= data[i].jenis %></td>
                        <td><%= data[i].harga %></td>
                        <td><%= data[i].waktu %></td>
                        <td>
                            <a href="/tarif/delete/<%= data[i].id %>" class="btn btn-sm btn-danger">Delete</a>
                            <a href="" data-bs-toggle="modal" data-bs-target="#edit<%= data[i].id %>" class="btn btn-sm btn-warning">edit</a>
                        </td>
                    </tr>

                    <div class="modal fade" id="edit<%= data[i].id %>" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Edit</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body">
                            <form action="tarif/update/<%= data[i].id %>" method="post">
                            <div class="mb-3">
                                <label for="exampleInputEmail1" class="form-label">Jenis</label>
                              <div class="form-check">
                              <input class="form-check-input" type="radio" name="jenis" id="motor" value="Motor"
                                <%= data[i].jenis === 'Motor' ? 'checked' : '' %>>
                              <label class="form-check-label" for="motor">Motor</label>
                            </div>

                            <div class="form-check">
                              <input class="form-check-input" type="radio" name="jenis" id="mobil" value="Mobil"
                                <%= data[i].jenis === 'Mobil' ? 'checked' : '' %>>
                              <label class="form-check-label" for="mobil">Mobil</label>
                            </div>

                            </div>
                            <div class="mb-3">
                                <label for="exampleInputPassword1" class="form-label">Tarif</label>
                                <input type="number" class="form-control" name="harga" value="<%= data[i].harga %>">
                            </div>

                            <div class="mb-3">
                                <label for="exampleInputPassword1" class="form-label">Waktu</label>
                                <input type="number" class="form-control" name="waktu" value="<%= data[i].waktu %>">
                            </div>
                            
                            
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                          </div>
                          </form>
                        </div>
                      </div>
                    </div>
                    
                <% } %>
             
            </tbody>
            </table>
        </div>
    </div>
    <!-- Modal Tarif-->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form action="tarif/save" method="post">
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Jenis</label>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="jenis" id="motor" value="Motor" checked>
                <label class="form-check-label" for="motor">
                  Motor
                </label>
                </div>
                <div class="form-check">
                <input class="form-check-input" type="radio" name="jenis" id="mobil" value="Mobil" >
                <label class="form-check-label" for="mobil">
                    Mobil
                </label>
                </div>
            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Tarif</label>
                <input type="number" class="form-control" name="harga">
            </div>

            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Waktu</label>
                <input type="number" class="form-control" name="waktu">
            </div>
            
            
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
          </form>
        </div>
      </div>
    </div>

</div>

<%- include('../../partials/_foot.ejs') %>