<header class="topnav">
    <div class="topnav-left">
        <button class="btn-sidebar-toggle d-lg-none me-2" id="sidebarToggle" aria-label="Toggle Menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <div>
            <div class="topnav-title">Sistem Monitoring Lahan Pertanian Presisi</div>
            <div class="topnav-sub">Kabupaten Sumenep · Sensor USB & Precision Farming</div>
        </div>
    </div>

    <div class="topnav-right">
        <div class="live-indicator">
            <span class="live-dot"></span>
            <span>Server aktif</span>
        </div>

        <div class="dropdown">
            <button class="btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                style="gap: 8px; font-size: 13px; padding: 6px 12px; border-radius: 6px;">
                <div class="avatar" style="width:24px; height:24px; font-size:11px; background: #0f172a; border-radius: 4px;">
                    <i class="fa-solid fa-user" style="font-size:10px;"></i>
                </div>
                <span class="fw-medium d-none d-sm-inline"><%= typeof email !== 'undefined' ? email.split('@')[0] : 'Administrator' %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 220px; padding: 6px; border-radius: 6px; border: 1px solid #e2e8f0;">
                <li class="px-2 py-1.5">
                    <div style="font-size:10.5px; color: var(--color-text-secondary); font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">Masuk sebagai</div>
                    <div style="font-size:13px; font-weight:600; color: var(--color-text-primary); margin-top: 2px;">
                        <%= typeof email !== 'undefined' ? email : 'admin@pens-agri.ac.id' %>
                    </div>
                    <% if (typeof userRole !== 'undefined' && Number(userRole) === 1) { %>
                    <span class="badge" style="background:#0f172a; color:#fff; font-size:10px; font-weight:600; margin-top:4px; padding: 2px 6px; border-radius: 4px;">Super Admin</span>
                    <% } else { %>
                    <span class="badge" style="background:#f1f5f9; color:#475569; font-size:10px; font-weight:600; margin-top:4px; padding: 2px 6px; border-radius: 4px; border: 1px solid #e2e8f0;">Petani / User</span>
                    <% } %>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li><a class="dropdown-item py-1.5" href="/users"><i class="fa-solid fa-gauge me-2 text-slate-600"></i> Dashboard</a></li>
                <li><a class="dropdown-item py-1.5" href="/policy_brief"><i class="fa-solid fa-brain me-2 text-slate-600"></i> AI Policy Brief</a></li>
                <% if (typeof userRole !== 'undefined' && Number(userRole) === 1) { %>
                <li><a class="dropdown-item py-1.5" href="/users_management"><i class="fa-solid fa-users-gear me-2 text-slate-600"></i> Manajemen Akun</a></li>
                <% } %>
                <li><hr class="dropdown-divider my-1"></li>
                <li><a class="dropdown-item text-danger py-1.5" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Keluar</a></li>
            </ul>
        </div>
    </div>
</header>