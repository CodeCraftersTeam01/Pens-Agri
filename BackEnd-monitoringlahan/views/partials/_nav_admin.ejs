<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<nav class="sidebar" id="mainSidebar">
    <!-- Brand -->
    <div class="d-flex justify-content-between align-items-center w-100 pe-2">
        <a href="/users" class="sidebar-brand flex-grow-1 border-0">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-leaf"></i>
            </div>
            <div class="sidebar-brand-text">
                <span class="sidebar-brand-name">PENS Agri</span>
                <span class="sidebar-brand-sub">Precision System</span>
            </div>
        </a>
        <button class="sidebar-close-btn d-lg-none" id="sidebarCloseBtn" aria-label="Tutup Menu">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <!-- Navigation -->
    <div class="sidebar-nav">
        <div class="sidebar-section-label">Menu Utama</div>

        <a class="sidebar-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/users') ? 'active' : '' %>" href="/users">
            <i class="fa-solid fa-house link-icon"></i>
            Dashboard
        </a>

        <a class="sidebar-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/policy_brief') ? 'active' : '' %>" href="/policy_brief">
            <i class="fa-solid fa-brain link-icon"></i>
            AI Policy Brief
        </a>

        <a class="sidebar-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/petalahan') ? 'active' : '' %>" href="/petalahan">
            <i class="fa-solid fa-map link-icon"></i>
            Peta Lahan
        </a>

        <a class="sidebar-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/sensor') ? 'active' : '' %>" href="/sensor">
            <i class="fa-solid fa-microchip link-icon"></i>
            Data Sensor
        </a>

        <div class="sidebar-section-label">Master Data</div>

        <%
            var isMasterActive = (typeof currentRoute !== 'undefined' && (
                currentRoute === '/kelompoktani' ||
                currentRoute === '/sayur_buah' ||
                currentRoute === '/biofarmaka' ||
                currentRoute === '/luas_tanam_perkebunan_rakyat'
            ));
        %>

        <a class="sidebar-link d-flex justify-content-between align-items-center <%= isMasterActive ? 'active' : '' %>"
           data-bs-toggle="collapse"
           href="#masterCollapse"
           role="button"
           aria-expanded="<%= isMasterActive ? 'true' : 'false' %>">
            <span class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-database link-icon"></i>
                Pertanian
            </span>
            <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
        </a>

        <div class="collapse <%= isMasterActive ? 'show' : '' %>" id="masterCollapse">
            <div class="sidebar-submenu">
                <a class="sidebar-sublink <%= (typeof currentRoute !== 'undefined' && currentRoute === '/kelompoktani') ? 'active' : '' %>" href="/kelompoktani">
                    Kelompok Tani
                </a>
                <a class="sidebar-sublink <%= (typeof currentRoute !== 'undefined' && currentRoute === '/sayur_buah') ? 'active' : '' %>" href="/sayur_buah">
                    Sayur & Buah
                </a>
                <a class="sidebar-sublink <%= (typeof currentRoute !== 'undefined' && currentRoute === '/biofarmaka') ? 'active' : '' %>" href="/biofarmaka">
                    Biofarmaka
                </a>
                <a class="sidebar-sublink <%= (typeof currentRoute !== 'undefined' && currentRoute === '/luas_tanam_perkebunan_rakyat') ? 'active' : '' %>" href="/luas_tanam_perkebunan_rakyat">
                    Luas Perkebunan
                </a>
            </div>
        </div>
    </div>
</nav>



