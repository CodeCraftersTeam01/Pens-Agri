<%- include('../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">

<style>
    .text-navy { color: #0a2240 !important; }
    .bg-navy { background-color: #0a2240 !important; }
    .border-navy { border-color: #0a2240 !important; }
    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #ffffff;
    }
    .table-custom thead {
        background-color: #0a2240;
        color: #ffffff;
    }
    .select-custom {
        max-width: 200px;
    }
    .badge-iot {
        font-family: 'Courier New', Courier, monospace;
        font-weight: bold;
    }
    /* Styling khusus rendering Markdown hasil AI */
    #ai-response-content h1, #ai-response-content h2, #ai-response-content h3 {
        color: #0a2240;
        margin-top: 1.5rem;
        margin-bottom: 0.8rem;
        font-weight: 700;
    }
    #ai-response-content h1 { font-size: 20px; border-bottom: 2px solid #0a2240; padding-bottom: 5px; }
    #ai-response-content h2 { font-size: 16px; }
    #ai-response-content h3 { font-size: 14px; }
    #ai-response-content p, #ai-response-content li {
        font-size: 13.5px;
        line-height: 1.6;
        color: #2c3e50;
    }
    #ai-response-content ul, #ai-response-content ol {
        padding-left: 20px;
        margin-bottom: 1rem;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <%- include('../../partials/_nav_admin.ejs') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 p-0">
            <%- include('../../partials/_top_nav_admin.ejs') %>

            <div class="p-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-4 border-bottom">
                    <div>
                        <h1 class="h2 fw-bold text-navy">Kecerdasan Buatan (AI) Policy Brief</h1>
                        <p class="text-secondary mb-0">Formulasi Kebijakan Strategis Berbasis Triangulasi Data Makro BPS & Sensor IoT Lapangan</p>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-primary bg-gradient shadow-sm text-nowrap fw-bold border-0 px-3 py-2" style="background-color: #0d6efd;" onclick="generateAiPolicy()">
                            <i class="fa-solid fa-brain me-2"></i>Kalkulasi & Hubungkan ke OpenAI
                        </button>

                        <div class="input-group">
                            <label class="input-group-text bg-navy text-white border-navy" for="filter-tahun">
                                <i class="fa-solid fa-calendar-days me-1"></i> Data BPS
                            </label>
                            <select class="form-select border-navy select-custom" id="filter-tahun" onchange="loadBpsData()">
                                <option value="2025" selected>2025</option>
                                <option value="2024">2024</option>
                                <option value="2023">2023</option>
                                <option value="2022">2022</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card card-custom p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-navy mb-0" id="tabel-judul">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>Mengubungkan WebAPI BPS Sumenep...
                                </h5>
                                <span class="badge bg-info text-dark">Pilar 1: Data Makro Regional</span>
                            </div>
                            
                            <div id="loading-bps" class="text-center my-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-secondary small">Menarik Interoperabilitas Data Simdasi Perkebunan BPS...</p>
                            </div>

                            <div class="table-responsive d-none" id="bps-table-container">
                                <table id="bps-table" class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size: 13px; width: 100%;">
                                    <thead id="bps-thead" class="table-dark"></thead>
                                    <tbody id="bps-tbody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card card-custom p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="fw-bold text-navy mb-0">
                                    <i class="fa-solid fa-server me-2"></i>Log Parameter Fisik Tanah & Infrastruktur Lapangan
                                </h4>
                                <span class="badge bg-success">Pilar 2 & 3: Data Mikro & Kelembagaan Meso</span>
                            </div>

                            <div class="table-responsive">
                                <table id="sensor-table" class="table table-custom table-striped table-hover align-middle mb-0" style="font-size: 12px; width:100%;">
                                    <thead>
                                        <tr class="text-center align-middle">
                                            <th rowspan="2" style="width: 3%">No</th>
                                            <th colspan="3" class="bg-primary text-white">Identifikasi Spasial & Kelembagaan</th>
                                            <th colspan="5" class="bg-info text-dark">Infrastruktur Air & Energi (Kuesioner)</th>
                                            <th colspan="2" class="bg-warning text-dark">Risiko Mekanisasi</th>
                                            <th colspan="7" class="bg-success text-white">Real-time Parameter NPK & Kondisi Tanah (Sensor IoT)</th>
                                            <th rowspan="2" style="width: 8%">Waktu Log</th>
                                        </tr>
                                        <tr class="text-center align-middle">
                                            <th>Nama Desa</th>
                                            <th>Koordinat (Lat, Long)</th>
                                            <th>Komoditas & Luas</th>
                                            <th>Irigasi</th>
                                            <th>Tadahan</th>
                                            <th>Listrik</th>
                                            <th>Pompa</th>
                                            <th>Kondisi Air</th>
                                            <th>Pembajak</th>
                                            <th>Gagal Panen</th>
                                            <th>Suhu (°C)</th>
                                            <th>Moist (%)</th>
                                            <th>pH</th>
                                            <th>EC (µS/cm)</th>
                                            <th>N (mg/kg)</th>
                                            <th>P (mg/kg)</th>
                                            <th>K (mg/kg)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (data && data.length > 0) { %>
                                            <% for(var i = 0; i < data.length; i++) { %>
                                                <tr class="sensor-row-data">
                                                    <td class="text-center">#<%= (i + 1) %></td>
                                                    <td class="cell-desa" data-val="<%= data[i].nama_desa %>">
                                                        <span class="fw-bold text-navy d-block"><%= data[i].nama_desa %></span>
                                                        <small class="text-muted text-xs cell-poktan" data-val="<%= data[i].kelompok_tani %>">
                                                            Poktan: <%= data[i].kelompok_tani ? data[i].kelompok_tani.toUpperCase() : 'TIDAK' %>
                                                        </small>
                                                    </td>
                                                    <td class="cell-koordinat" data-val="<%= data[i].latitude %>,<%= data[i].longitude %>">
                                                        <small class="font-monospace text-secondary"><%= data[i].latitude %>, <%= data[i].longitude %></small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success mb-1 cell-komoditas" data-val="<%= data[i].komoditas %>"><%= data[i].komoditas %></span><br>
                                                        <span class="fw-semibold text-navy cell-luas" data-val="<%= data[i].luas_lahan %>"><%= data[i].luas_lahan %> Ha</span>
                                                    </td>
                                                    <td class="text-center cell-irigasi" data-val="<%= data[i].irigasi %>">
                                                        <span class="badge <%= data[i].irigasi === 'ya' ? 'bg-success' : 'bg-danger' %>"><%= data[i].irigasi %></span>
                                                    </td>
                                                    <td class="cell-tadahan" data-val="<%= data[i].tadahan_hujan %>"><%= data[i].tadahan_hujan || '-' %></td>
                                                    <td class="text-center cell-listrik" data-val="<%= data[i].listrik %>">
                                                        <span class="badge <%= data[i].listrik === 'ya' ? 'bg-info text-dark' : 'bg-secondary' %>"><%= data[i].listrik %></span>
                                                    </td>
                                                    <td class="cell-pompa" data-val="<%= data[i].pompa_air %> (<%= data[i].sumber_energi_pompa %>)">
                                                        <%= data[i].pompa_air %> <small class="text-muted">(<%= data[i].sumber_energi_pompa %>)</small>
                                                    </td>
                                                    <td class="text-center cell-kondisi-air" data-val="<%= data[i].kondisi_air %>">
                                                        <span class="badge <%= data[i].kondisi_air === 'Sulit' ? 'bg-danger' : 'bg-success' %>"><%= data[i].kondisi_air %></span>
                                                    </td>
                                                    <td class="cell-pembajak" data-val="<%= data[i].pembajak %>"><%= data[i].pembajak || '-' %></td>
                                                    <td class="text-center cell-gagal-panen" data-val="<%= data[i].gagal_panen %>">
                                                        <span class="badge <%= data[i].gagal_panen === 'ya' ? 'bg-danger' : 'bg-success' %>"><%= data[i].gagal_panen %></span>
                                                    </td>
                                                    <td class="text-center text-warning fw-bold cell-temp" data-val="<%= data[i].temp %>"><%= data[i].temp %>°C</td>
                                                    <td class="text-center text-info fw-bold cell-moisture" data-val="<%= data[i].moisture %>"><%= data[i].moisture %>%</td>
                                                    <td class="text-center fw-bold cell-ph" data-val="<%= data[i].ph %>"><%= data[i].ph %></td>
                                                    <td class="text-center text-muted font-monospace cell-ec" data-val="<%= data[i].conductivity %>"><%= data[i].conductivity %></td>
                                                    <td class="text-center text-success fw-bold cell-n" data-val="<%= data[i].nitrogen %>"><%= data[i].nitrogen %></td>
                                                    <td class="text-center text-danger fw-bold cell-p" data-val="<%= data[i].phosphorus %>"><%= data[i].phosphorus %></td>
                                                    <td class="text-center text-primary fw-bold cell-k" data-val="<%= data[i].potassium %>"><%= data[i].potassium %></td>
                                                    <td>
                                                        <small class="text-secondary">
                                                            <%= new Date(data[i].created_at).toLocaleDateString('id-ID') %>
                                                        </small>
                                                    </td>
                                                </tr>
                                            <% } %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="19" class="text-center text-muted py-4">Data monitoring lahan dari database lokal kosong.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

<div class="modal fade" id="aiPolicyModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="aiPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title fw-bold" id="aiPolicyModalLabel">
                    <i class="fa-solid fa-robot me-2"></i>Hasil Analisis Inteligensia Buatan - Dinas Pertanian Sumenep
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-close="modal" aria-label="Close" onclick="window.location.reload()"></button>
            </div>
            <div class="modal-body bg-light">
                <div id="ai-loading-state" class="text-center my-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3.5rem; height: 3.5rem;"></div>
                    <h5 class="fw-bold text-navy">OpenAI Engine Sedang Menganalisis Big Data Lahan...</h5>
                    <p class="text-secondary px-5 mx-5 small">Model sedang melakukan inferensi komprehensif dengan memadukan data kuantitatif makro, sebaran spasial meso kelompok tani, serta korelasi kimia tanah NPK dan pH dari lapangan. Sinkronisasi memakan waktu kurang lebih 10-30 detik...</p>
                </div>
                <div id="ai-response-content" class="p-4 bg-white card-custom d-none">
                    </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-close="modal" onclick="window.location.reload()">Tutup Jendela</button>
                <button type="button" class="btn btn-navy text-white shadow" onclick="printPolicyBrief()">
                    <i class="fa-solid fa-print me-1"></i> Cetak Rekomendasi (PDF)
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
    let bpsGlobalData = []; // Menyimpan data BPS untuk disuntikkan ke dalam prompt AI

    $(document).ready(function() {
        // Inisialisasi DataTables internal local data
        $('#sensor-table').DataTable({
            pageLength: 5,
            scrollX: true,
            ordering: true,
            language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json" }
        });
        
        // Load data eksternal BPS saat pertama kali membuka halaman
        loadBpsData();
    });

    // Ambil Data Live Makro Interoperabilitas dari WebAPI BPS Sumenep
    function loadBpsData() {
        const tahunTerpilih = $('#filter-tahun').val();
        const apiUrl = `https://webapi.bps.go.id/v1/api/interoperabilitas/datasource/simdasi/id/25/tahun/${tahunTerpilih}/id_tabel/QjFRZTg2YnBaZXFuL3RHWW04Zjh0UT09/wilayah/3529000/key/4e3651da88d5966fa36156caed42c4bc`;
        
        bpsGlobalData = []; 
        $('#loading-bps').removeClass('d-none');
        $('#bps-table-container').addClass('d-none');

        if ($.fn.DataTable.isDataTable('#bps-table')) {
            $('#bps-table').DataTable().destroy();
        }

        fetch(apiUrl)
            .then(response => response.json())
            .then(res => {
                if (res.status === "OK" && res.data && res.data[1]) {
                    const metadata = res.data[1];
                    const rowsData = metadata.data || [];
                    const variabelKey = Object.keys(metadata.kolom)[0];
                    
                    $('#tabel-judul').html(`<i class="fa-solid fa-chart-line me-2"></i> ${metadata.judul_tabel}`);
                    let headerHtml = `<tr><th style="width:8%;">No</th><th>Komoditas Perkebunan (BPS Makro)</th><th style="text-align: right; width:25%;">Luas Areal (Ribu Ha)</th></tr>`;
                    $('#bps-thead').html(headerHtml);

                    let bodyHtml = '';
                    rowsData.forEach((row, index) => {
                        let jenis = row.label || 'Unknown';
                        let val = (row.variables && row.variables[variabelKey]) ? row.variables[variabelKey].value : '–';
                        
                        // Push ke objek array global untuk ditangkap fungsi AI Generator
                        bpsGlobalData.push({ komoditas: jenis, luas_makro_ribu_ha: val });

                        bodyHtml += `<tr><td class="text-center">${index + 1}</td><td class="fw-bold text-navy"><i class="fa-solid fa-leaf text-success me-2"></i>${jenis}</td><td class="text-end fw-bold">${val}</td></tr>`;
                    });
                    
                    $('#bps-tbody').html(bodyHtml);
                    $('#loading-bps').addClass('d-none');
                    $('#bps-table-container').removeClass('d-none');

                    $('#bps-table').DataTable({
                        pageLength: 5,
                        searching: false,
                        lengthChange: false,
                        language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json" }
                    });
                }
            }).catch(e => {
                console.error("BPS Error Connection:", e);
                $('#loading-bps').addClass('d-none');
                $('#tabel-judul').text('Koneksi WebAPI BPS Gagal Terhubung');
            });
    }

    // FUNGSI CORE: SCRAPING DATA DOM EJS LALU HIT POST KE BACKEND EXPRESS
    function generateAiPolicy() {
    // Tampilkan Dialog Modal Loading Status
    var myModal = new bootstrap.Modal(document.getElementById('aiPolicyModal'));
    myModal.show();
    $('#ai-loading-state').removeClass('d-none');
    $('#ai-response-content').addClass('d-none');

    // 1. Satukan Payload Ringan (Komputasi 100.000+ data sensor dilakukan otomatis secara native di SQL backend)
    const dataPayload = {
        tahun_bps: $('#filter-tahun').val(),
        data_makro_bps: bpsGlobalData
    };

    // 3. Tembak AJAX Menggunakan Endpoint ABSOLUT
    fetch('/policy_brief/generate-policy', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(dataPayload)
    })
    .then(async response => {
        const result = await response.json().catch(() => null);
        if (!response.ok) {
            throw new Error((result && result.message) || ("Server memberikan respons status " + response.status));
        }
        return result;
    })
    .then(result => {
        if(result && result.success && result.policyBriefText) {
            // Render markdown ke HTML
            let cleanHtml = marked.parse(result.policyBriefText);
            $('#ai-loading-state').addClass('d-none');
            $('#ai-response-content').html(cleanHtml).removeClass('d-none');
        } else {
            throw new Error((result && result.message) || "Gagal memproses rekomendasi AI.");
        }
    })
    .catch(err => {
        console.error("Fetch AI Error:", err);
        $('#ai-loading-state').html(`
            <i class="fa-solid fa-circle-exclamation text-danger fa-3x mb-3"></i>
            <h5 class="text-danger fw-bold">Gagal Mengirimkan Data ke OpenAI</h5>
            <p class="text-secondary px-4 small">${err.message || 'Terjadi kesalahan pada sistem.'}</p>
        `);
    });
}
    // Fungsi Cetak Instan untuk Kebutuhan Dokumentasi Fisik Lapangan Dinas
    function printPolicyBrief() {
        var bodyPrint = document.getElementById('ai-response-content').innerHTML;
        var originalContent = document.body.innerHTML;
        document.body.innerHTML = "<html><head><title>Policy_Brief_Dinas_Pertanian_Sumenep_AI</title><style>body{padding:50px; font-family:Arial,sans-serif;} h1,h2,h3{color:#0a2240; border-bottom:1px solid #ddd; padding-bottom:5px;}</style></head><body>" + bodyPrint + "</body></html>";
        window.print();
        window.location.reload(); // Refresh untuk mengembalikan state DOM semula
    }
</script>

<%- include('../../partials/_foot_admin.ejs') %>