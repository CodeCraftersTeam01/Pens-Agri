<%- include('../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">

<style>
    .select-custom {
        max-width: 180px;
        background: var(--color-surface) !important;
        border: 1px solid var(--color-border) !important;
        border-radius: var(--radius-md);
        font-size: 13.5px;
    }

    /* DataTable Container Controls */
    .dataTables_wrapper {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: auto !important;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 14px !important;
        font-size: 13px !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid var(--color-border) !important;
        border-radius: 8px !important;
        padding: 5px 10px !important;
        font-size: 13px !important;
        outline: none !important;
    }

    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin-top: 14px !important;
        font-size: 13px !important;
    }

    /* AI Markdown output styling */
    #ai-response-content h1 {
        color: var(--color-text-primary);
        font-size: 18px;
        font-weight: 700;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 8px;
        margin-top: 1.2rem;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }
    #ai-response-content h2 {
        color: var(--color-text-primary);
        font-size: 15px;
        font-weight: 600;
        margin-top: 1.2rem;
        margin-bottom: 0.6rem;
    }
    #ai-response-content h3 {
        color: var(--color-text-primary);
        font-size: 13.5px;
        font-weight: 600;
        margin-top: 1rem;
    }
    #ai-response-content p, #ai-response-content li {
        font-size: 13.5px;
        line-height: 1.75;
        color: var(--color-text-secondary);
    }
    #ai-response-content ul, #ai-response-content ol {
        padding-left: 20px;
        margin-bottom: 1rem;
    }
</style>

<div style="display: flex; min-height: 100vh;">
    <%- include('../../partials/_nav_admin.ejs') %>

    <div class="main-content">
        <%- include('../../partials/_top_nav_admin.ejs') %>

        <div class="page-content-wrapper">
            <!-- Page Header -->
            <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
                <div>
                    <div style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: var(--color-blue); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
                        <i class="fa-solid fa-brain"></i> Generative AI System
                    </div>
                    <h1 class="page-header-title">AI Policy Brief</h1>
                    <p style="font-size: 13px; color: var(--color-text-secondary); margin: 4px 0 0;">Formulasi kebijakan strategis berbasis triangulasi data makro BPS & data sensor tanah lapangan.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn-primary-accent" id="btnGenerateAi">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Generate AI Analysis
                    </button>
                    <select class="select-custom" id="filter-tahun" style="padding: 7px 12px; border-radius: var(--radius-md); font-family: inherit; cursor: pointer;">
                        <option value="2025" selected>BPS 2025</option>
                        <option value="2024">BPS 2024</option>
                        <option value="2023">BPS 2023</option>
                        <option value="2022">BPS 2022</option>
                    </select>
                </div>
            </div>

            <!-- BPS Table Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <div class="section-title" id="tabel-judul">
                            <span class="spinner-border spinner-border-sm me-2" role="status" style="width:14px;height:14px;border-width:2px;"></span>Menghubungkan WebAPI BPS Sumenep...
                        </div>
                        <div class="section-sub">Pilar 1 — Data Makro Regional Perkebunan</div>
                    </div>
                    <span class="pill blue">BPS Sumenep</span>
                </div>

                <div id="loading-bps" class="text-center" style="padding: 32px;">
                    <div class="spinner-border" role="status" style="width:28px;height:28px;border-width:2px;color:var(--color-accent);"></div>
                    <p style="margin-top:12px;font-size:13px;color:var(--color-text-secondary);">Menarik data interoperabilitas BPS Simdasi...</p>
                </div>

                <div class="table-responsive d-none" id="bps-table-container">
                    <table id="bps-table" class="table table-sm table-hover align-middle mb-0" style="font-size: 13px; width: 100%;">
                        <thead id="bps-thead"></thead>
                        <tbody id="bps-tbody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Sensor Table Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <div class="section-title">Log Parameter Fisik Tanah & Infrastruktur Lapangan</div>
                        <div class="section-sub">Pratinjau telemetri sensor dari 640+ titik lahan — Pilar 2 & 3</div>
                    </div>
                    <span class="pill green">Data Mikro & Kelembagaan</span>
                </div>

                    <div class="table-responsive">
                        <table id="sensor-table" class="table table-hover align-middle mb-0" style="font-size: 12px; width:100%;">
                            <thead>
                                <tr class="text-center align-middle" style="background: rgba(10, 37, 64, 0.04);">
                                    <th rowspan="2" style="width: 3%">No</th>
                                    <th colspan="3" class="text-primary fw-bold">Identifikasi Spasial & Kelembagaan</th>
                                    <th colspan="5" class="text-info fw-bold">Infrastruktur Air & Energi</th>
                                    <th colspan="2" class="text-warning fw-bold">Risiko</th>
                                    <th colspan="7" class="text-success fw-bold">Real-time Parameter NPK & Kondisi Tanah</th>
                                    <th rowspan="2" style="width: 8%">Waktu Log</th>
                                </tr>
                                <tr class="text-center align-middle" style="font-size: 11px; background: rgba(10, 37, 64, 0.02);">
                                    <th>Nama Desa</th>
                                    <th>Koordinat (Lat, Long)</th>
                                    <th>Komoditas & Luas</th>
                                    <th>Irigasi</th>
                                    <th>Tadahan</th>
                                    <th>Listrik</th>
                                    <th>Pompa</th>
                                    <th>Kondisi Air</th>
                                    <th>Pembajak</th>
                                    <th>Gagal Panen</th>
                                    <th>Suhu (°C)</th>
                                    <th>Moist (%)</th>
                                    <th>pH</th>
                                    <th>EC (µS/cm)</th>
                                    <th>N (mg/kg)</th>
                                    <th>P (mg/kg)</th>
                                    <th>K (mg/kg)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (data && data.length > 0) { %>
                                    <% for(var i = 0; i < data.length; i++) { %>
                                        <tr class="sensor-row-data">
                                            <td class="text-center text-muted fw-bold">#<%= (i + 1) %></td>
                                            <td class="cell-desa" data-val="<%= data[i].nama_desa %>">
                                                <span class="fw-bold text-navy d-block"><%= data[i].nama_desa %></span>
                                                <small class="text-muted text-xs cell-poktan" data-val="<%= data[i].kelompok_tani %>">
                                                    Poktan: <%= data[i].kelompok_tani ? data[i].kelompok_tani.toUpperCase() : 'TIDAK' %>
                                                </small>
                                            </td>
                                            <td class="cell-koordinat" data-val="<%= data[i].latitude %>,<%= data[i].longitude %>">
                                                <small class="font-monospace text-secondary"><%= data[i].latitude %>, <%= data[i].longitude %></small>
                                            </td>
                                            <td>
                                                <span class="badge-soft-success mb-1 cell-komoditas" data-val="<%= data[i].komoditas %>"><%= data[i].komoditas %></span><br>
                                                <span class="fw-semibold text-navy cell-luas" data-val="<%= data[i].luas_lahan %>"><%= data[i].luas_lahan %> Ha</span>
                                            </td>
                                            <td class="text-center cell-irigasi" data-val="<%= data[i].irigasi %>">
                                                <span class="<%= data[i].irigasi === 'ya' ? 'badge-soft-success' : 'badge-soft-danger' %>"><%= data[i].irigasi %></span>
                                            </td>
                                            <td class="cell-tadahan" data-val="<%= data[i].tadahan_hujan %>"><%= data[i].tadahan_hujan || '-' %></td>
                                            <td class="text-center cell-listrik" data-val="<%= data[i].listrik %>">
                                                <span class="<%= data[i].listrik === 'ya' ? 'badge-soft-info' : 'badge-soft-secondary' %>"><%= data[i].listrik %></span>
                                            </td>
                                            <td class="cell-pompa" data-val="<%= data[i].pompa_air %> (<%= data[i].sumber_energi_pompa %>)">
                                                <%= data[i].pompa_air %> <small class="text-muted">(<%= data[i].sumber_energi_pompa %>)</small>
                                            </td>
                                            <td class="text-center cell-kondisi-air" data-val="<%= data[i].kondisi_air %>">
                                                <span class="<%= data[i].kondisi_air === 'Sulit' ? 'badge-soft-danger' : 'badge-soft-success' %>"><%= data[i].kondisi_air %></span>
                                            </td>
                                            <td class="cell-pembajak" data-val="<%= data[i].pembajak %>"><%= data[i].pembajak || '-' %></td>
                                            <td class="text-center cell-gagal-panen" data-val="<%= data[i].gagal_panen %>">
                                                <span class="<%= data[i].gagal_panen === 'ya' ? 'badge-soft-danger' : 'badge-soft-success' %>"><%= data[i].gagal_panen %></span>
                                            </td>
                                            <td class="text-center text-warning fw-bold cell-temp" data-val="<%= data[i].temp %>"><%= data[i].temp %>°C</td>
                                            <td class="text-center text-info fw-bold cell-moisture" data-val="<%= data[i].moisture %>"><%= data[i].moisture %>%</td>
                                            <td class="text-center fw-bold cell-ph" data-val="<%= data[i].ph %>"><%= data[i].ph %></td>
                                            <td class="text-center text-muted font-monospace cell-ec" data-val="<%= data[i].conductivity %>"><%= data[i].conductivity %></td>
                                            <td class="text-center text-success fw-bold cell-n" data-val="<%= data[i].nitrogen %>"><%= data[i].nitrogen %></td>
                                            <td class="text-center text-danger fw-bold cell-p" data-val="<%= data[i].phosphorus %>"><%= data[i].phosphorus %></td>
                                            <td class="text-center text-primary fw-bold cell-k" data-val="<%= data[i].potassium %>"><%= data[i].potassium %></td>
                                            <td>
                                                <small class="text-secondary">
                                                    <%= new Date(data[i].created_at).toLocaleDateString('id-ID') %>
                                                </small>
                                            </td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="19" class="text-center text-muted py-4">Data monitoring lahan dari database lokal kosong.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal Dialog AI Policy Brief -->
<div class="modal fade" id="aiPolicyModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="aiPolicyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="border: 1px solid var(--color-border); border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.12); overflow: hidden;">
            <div class="modal-header" style="background: #0b1c33; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 18px 24px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width:34px; height:34px; background:#16a34a; border-radius:8px; display:flex; align-items:center; justify-content:center; color:white; font-size:14px;">
                        <i class="fa-solid fa-brain"></i>
                    </div>
                    <div>
                        <div id="aiPolicyModalLabel" style="font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.01em;">Hasil Analisis AI Policy Brief</div>
                        <div style="font-size: 12px; color: #94a3b8;">Dinas Pertanian & Ketahanan Pangan Kabupaten Sumenep</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 65vh; padding: 24px;">
                <div id="ai-loading-state" class="text-center" style="padding: 48px;">
                    <div class="spinner-border mb-3" role="status" style="width:40px;height:40px;border-width:3px;color:var(--color-accent);"></div>
                    <div style="font-size:15px;font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">OpenAI Engine sedang menganalisis...</div>
                    <p style="font-size:13px;color:var(--color-text-secondary);max-width:500px;margin:0 auto;">Memadukan data makro BPS, sebaran spasial kelompok tani, serta parameter NPK dan pH tanah real-time.</p>
                </div>
                <div id="ai-response-content" style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 24px;" class="d-none">
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--color-border); padding: 14px 20px; display: flex; justify-content: space-between;">
                <button type="button" class="btn-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="button" class="btn-primary-accent" onclick="printPolicyBrief()">
                    <i class="fa-solid fa-print"></i> Cetak PDF
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
    let bpsGlobalData = []; // Menyimpan data BPS untuk disuntikkan ke dalam prompt AI
    let isGeneratingPolicy = false;

    $(document).ready(function() {
        // Inisialisasi DataTables internal local data
        $('#sensor-table').DataTable({
            pageLength: 5,
            scrollX: true,
            ordering: true,
            language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json" }
        });
        
        // Bind tombol generate & filter tahun
        $('#btnGenerateAi').on('click', function(e) {
            e.preventDefault();
            generateAiPolicy();
        });

        $('#filter-tahun').on('change', function() {
            loadBpsData();
        });

        // Load data eksternal BPS saat pertama kali membuka halaman
        loadBpsData();
    });

    // Ambil Data Live Makro Interoperabilitas dari WebAPI BPS Sumenep
    function loadBpsData() {
        const tahunTerpilih = $('#filter-tahun').val();
        const apiUrl = `https://webapi.bps.go.id/v1/api/interoperabilitas/datasource/simdasi/id/25/tahun/${tahunTerpilih}/id_tabel/QjFRZTg2YnBaZXFuL3RHWW04Zjh0UT09/wilayah/3529000/key/4e3651da88d5966fa36156caed42c4bc`;
        
        bpsGlobalData = []; 
        $('#loading-bps').removeClass('d-none');
        $('#bps-table-container').addClass('d-none');

        if ($.fn.DataTable.isDataTable('#bps-table')) {
            $('#bps-table').DataTable().destroy();
        }

        fetch(apiUrl)
            .then(response => response.json())
            .then(res => {
                if (res.status === "OK" && res.data && res.data[1]) {
                    const metadata = res.data[1];
                    const rowsData = metadata.data || [];
                    const variabelKey = Object.keys(metadata.kolom)[0];
                    
                    $('#tabel-judul').html(`<i class="fa-solid fa-chart-line me-2"></i> ${metadata.judul_tabel}`);
                    let headerHtml = `<tr><th style="width:8%;">No</th><th>Komoditas Perkebunan (BPS Makro)</th><th style="text-align: right; width:25%;">Luas Areal (Ribu Ha)</th></tr>`;
                    $('#bps-thead').html(headerHtml);

                    let bodyHtml = '';
                    rowsData.forEach((row, index) => {
                        let jenis = row.label || 'Unknown';
                        let val = (row.variables && row.variables[variabelKey]) ? row.variables[variabelKey].value : '–';
                        
                        // Push ke objek array global untuk ditangkap fungsi AI Generator
                        bpsGlobalData.push({ komoditas: jenis, luas_makro_ribu_ha: val });

                        bodyHtml += `<tr><td class="text-center">${index + 1}</td><td class="fw-bold text-navy"><i class="fa-solid fa-leaf text-success me-2"></i>${jenis}</td><td class="text-end fw-bold">${val}</td></tr>`;
                    });
                    
                    $('#bps-tbody').html(bodyHtml);
                    $('#loading-bps').addClass('d-none');
                    $('#bps-table-container').removeClass('d-none');

                    $('#bps-table').DataTable({
                        pageLength: 5,
                        searching: false,
                        lengthChange: false,
                        language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json" }
                    });
                }
            }).catch(e => {
                console.error("BPS Error Connection:", e);
                $('#loading-bps').addClass('d-none');
                $('#tabel-judul').text('Koneksi WebAPI BPS Gagal Terhubung');
            });
    }

    // FUNGSI CORE: SCRAPING DATA DOM EJS LALU HIT POST KE BACKEND EXPRESS
    function generateAiPolicy() {
        if (isGeneratingPolicy) return;
        isGeneratingPolicy = true;

        const modalEl = document.getElementById('aiPolicyModal');
        if (modalEl) {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                const myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                myModal.show();
            } else if (window.jQuery && typeof $('#aiPolicyModal').modal === 'function') {
                $('#aiPolicyModal').modal('show');
            }
        }
        
        // Reset state modal ke loading
        $('#ai-loading-state').html(`
            <div class="spinner-border mb-3" role="status" style="width:40px;height:40px;border-width:3px;color:var(--color-accent);"></div>
            <div style="font-size:15px;font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">OpenAI Engine sedang menganalisis...</div>
            <p style="font-size:13px;color:var(--color-text-secondary);max-width:500px;margin:0 auto;">Memadukan data makro BPS, sebaran spasial kelompok tani, serta parameter NPK dan pH tanah real-time.</p>
        `).removeClass('d-none');
        $('#ai-response-content').addClass('d-none').html('');
        $('#btnGenerateAi').prop('disabled', true).addClass('opacity-50');

        // 1. Satukan Payload Ringan
        const dataPayload = {
            tahun_bps: $('#filter-tahun').val(),
            data_makro_bps: bpsGlobalData
        };

        // 2. Tembak AJAX Menggunakan $.ajax untuk reliabilitas tinggi
        $.ajax({
            url: '/policy_brief/generate-policy',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dataPayload),
            timeout: 120000,
            success: function(result) {
                if(result && result.success && result.policyBriefText) {
                    let cleanHtml = typeof marked !== 'undefined' ? marked.parse(result.policyBriefText) : result.policyBriefText;
                    $('#ai-loading-state').addClass('d-none');
                    $('#ai-response-content').html(cleanHtml).removeClass('d-none');
                } else {
                    showError((result && result.message) || "Gagal memproses rekomendasi AI.");
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX AI Error:", status, error, xhr);
                let msg = 'Terjadi kesalahan komunikasi dengan server.';
                try {
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        const parsed = JSON.parse(xhr.responseText);
                        if (parsed.message) msg = parsed.message;
                    }
                } catch(e) {}
                if (status === 'timeout') {
                    msg = 'Waktu permintaan habis (timeout). Server AI sedang padat, silakan coba beberapa saat lagi.';
                }
                showError(msg);
            },
            complete: function() {
                isGeneratingPolicy = false;
                $('#btnGenerateAi').prop('disabled', false).removeClass('opacity-50');
            }
        });

        function showError(errorMessage) {
            $('#ai-loading-state').html(`
                <div class="text-center py-4">
                    <i class="fa-solid fa-circle-exclamation text-danger fa-3x mb-3"></i>
                    <h5 class="text-danger fw-bold">Gagal Menghasilkan Rekomendasi AI</h5>
                    <p class="text-secondary px-4 small mb-0">${errorMessage}</p>
                </div>
            `).removeClass('d-none');
            $('#ai-response-content').addClass('d-none');
        }
    }

    // Fungsi Cetak Instan untuk Kebutuhan Dokumentasi Fisik Lapangan Dinas
    function printPolicyBrief() {
        const printContent = document.getElementById('ai-response-content').innerHTML;
        if (!printContent) return;
        const printWindow = window.open('', '_blank', 'height=800,width=900');
        printWindow.document.write('<!DOCTYPE html><html><head><title>AI Policy Brief - Dinas Pertanian Sumenep</title>');
        printWindow.document.write('<style>body{padding:40px;font-family:Arial,sans-serif;color:#111827;line-height:1.6;} h1{font-size:20px;color:#0b1c33;border-bottom:2px solid #e5e7eb;padding-bottom:8px;margin-bottom:16px;} h2{font-size:16px;color:#0b1c33;margin-top:20px;border-bottom:1px solid #f1f5f9;padding-bottom:4px;} h3{font-size:14px;color:#1f2937;margin-top:16px;} p,li{font-size:13px;color:#374151;} ul,ol{padding-left:20px;}</style></head><body>');
        printWindow.document.write(printContent);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        setTimeout(function() {
            printWindow.print();
        }, 250);
    }
</script>

<%- include('../../partials/_foot_admin.ejs') %>