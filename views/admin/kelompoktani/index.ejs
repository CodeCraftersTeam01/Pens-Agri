<%- include('../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<div class="container-fluid">
    <div class="row">
        <%- include('../../partials/_nav_admin.ejs') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 p-0">
            <%- include('../../partials/_top_nav_admin.ejs') %>

            <div class="p-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-3">
                    <h1 class="h2 fw-bold text-navy">Data Kelompok Tani</h1>
                    <button class="btn btn-sm btn-navy shadow-sm" onclick="window.location.reload();">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                    </button>
                </div>
            
                <div class="card card-custom p-3">
                    <h5 class="card-title mb-3 fw-semibold text-navy">Daftar Registrasi Kelompok Tani (KTH)</h5>
                    <div class="table-responsive">
                        <table class="table table-custom table-hover align-middle mb-0" style="font-size: 13px; width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 5%; text-align: center;">No</th>
                                    <th style="width: 5%; text-align: center;">Aksi</th>
                                    <th>Nama Kelompok</th>
                                    <th>No. Register</th>
                                    <th style="text-align: center;">Tanggal Berdiri</th>
                                    <th style="text-align: center;">Kelas</th>
                                    <th>Alamat</th>
                                    <th>Ketua</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (data && data.length > 0) { %>
                                    <% for(var i = 0; i < data.length; i++) { %>
                                        <tr>
                                            <td class="text-center">#<%= (i + 1) %></td>
                                            <td class="text-center">
                                                <a href="/kelompoktani/delete/<%= data[i].id %>" class="btn btn-sm btn-danger" onclick="return confirm('Apakah Anda yakin ingin menghapus data ini?');">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                            <td class="fw-bold text-navy"><%= data[i].nama_kelompok %></td>
                                            <td><code><%= data[i].no_register %></code></td>
                                            <td class="text-center">
                                                <%= data[i].tanggal_berdiri ? new Date(data[i].tanggal_berdiri).toLocaleDateString('id-ID', { dateStyle: 'medium' }) : '–' %>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary"><%= data[i].kelas %></span>
                                            </td>
                                            <td style="white-space: normal; min-width: 250px;"><%= data[i].alamat %></td>
                                            <td class="fw-semibold"><%= data[i].ketua %></td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center text-secondary py-4">
                                            <i class="fa-solid fa-database me-2"></i> Belum ada data kelompok tani di database.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

<script>
  $(document).ready(function() {
    $('.table-custom').DataTable({
      dom: 'Bfrtip',
      buttons: [
        'copy', 'csv', 'excel', 'pdf', 'print'
      ],
      pageLength: 10,
      responsive: true,
      ordering: true,
      language: {
        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json"
      }
    });
  });
</script>

<%- include('../../partials/_foot_admin.ejs') %>