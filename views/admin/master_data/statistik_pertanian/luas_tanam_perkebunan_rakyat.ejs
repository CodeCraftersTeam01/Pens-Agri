<%- include('../../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<div style="display: flex; min-height: 100vh;">
    <%- include('../../../partials/_nav_admin.ejs') %>

    <div class="main-content">
        <%- include('../../../partials/_top_nav_admin.ejs') %>

        <div class="page-content-wrapper">
            <div class="d-flex justify-content-between flex-wrap align-items-center mb-4 gap-3">
                <div>
                    <div class="page-header-eyebrow">
                        <i class="fa-solid fa-tree"></i>
                        Statistik Perkebunan (BPS API Direct)
                    </div>
                    <h1 class="page-header-title">Luas Tanam Perkebunan Rakyat</h1>
                    <p class="page-header-sub">Data komoditas perkebunan rakyat Kabupaten Sumenep</p>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group">
                        <label class="input-group-text bg-light text-secondary border" for="filter-tahun" style="font-size: 13px;">
                            <i class="fa-solid fa-calendar-days me-1 text-primary"></i> Tahun Data
                        </label>
                        <select class="form-select select-custom" id="filter-tahun" onchange="loadBpsData()" style="font-size: 13px;">
                            <option value="2025" selected>2025</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                        </select>
                    </div>
                    
                    <button class="btn-secondary text-nowrap" onclick="loadBpsData();">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                    </button>
                </div>
            </div>
        
            <div class="card p-4">
                <h5 class="section-title mb-3" id="tabel-judul">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>Memuat Judul Tabel BPS...
                </h5>
                
                <div id="loading-state" class="text-center my-5">
                    <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
                    <p class="mt-2 text-secondary" style="font-size: 13.5px;">Sedang mengambil dan memproses data dari WebAPI BPS...</p>
                </div>

                <div class="table-responsive d-none" id="table-container">
                    <table id="bps-table" class="table table-striped table-hover align-middle mb-0" style="font-size: 13px; width: 100%;">
                        <thead id="bps-thead">
                        </thead>
                        <tbody id="bps-tbody">
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
  $(document).ready(function() {
      loadBpsData();
  });

  function loadBpsData() {
      const tahunTerpilih = $('#filter-tahun').val();
      
      // Menggunakan token ID Tabel Luas Areal Tanaman Perkebunan Rakyat (QjFRZTg2YnBaZXFuL3RHWW04Zjh0UT09)
      const apiUrl = `https://webapi.bps.go.id/v1/api/interoperabilitas/datasource/simdasi/id/25/tahun/${tahunTerpilih}/id_tabel/QjFRZTg2YnBaZXFuL3RHWW04Zjh0UT09/wilayah/3529000/key/4e3651da88d5966fa36156caed42c4bc`;
      
      $('#loading-state').removeClass('d-none');
      $('#table-container').addClass('d-none');
      $('#tabel-judul').html('<span class="spinner-border spinner-border-sm me-2"></span>Memuat Judul Tabel BPS...');

      if ($.fn.DataTable.isDataTable('#bps-table')) {
          $('#bps-table').DataTable().destroy();
      }
      
      $('#bps-thead').empty();
      $('#bps-tbody').empty();

      fetch(apiUrl)
          .then(response => {
              if (!response.ok) {
                  throw new Error('Jaringan bermasalah atau API Key tidak valid');
              }
              return response.json();
          })
          .then(res => {
              if (res.status === "OK" && res.data && res.data[1]) {
                  const metadata = res.data[1];
                  const kolomObj = metadata.kolom;
                  const rowsData = metadata.data || [];
                  
                  // Mengambil key variabel dinamis pertama (s327j6qud4)
                  const variabelKey = Object.keys(kolomObj)[0]; 
                  const namaVariabelHeader = kolomObj[variabelKey] ? kolomObj[variabelKey].nama_variabel : "Luas Areal (ribu ha)";

                  // 1. Set Judul Tabel Secara Dinamis
                  $('#tabel-judul').text(metadata.judul_tabel);

                  // 2. Buat Header Kolom Menyesuaikan Jenis Data Vertikal
                  let headerHtml = `
                    <tr>
                        <th style="width: 8%; text-align: center;">No</th>
                        <th>Jenis Tanaman Perkebunan</th>
                        <th style="text-align: right;">${namaVariabelHeader}</th>
                    </tr>`;
                  $('#bps-thead').html(headerHtml);

                  // 3. Buat Baris Data Berdasarkan Jenis Tanaman (<tbody>)
                  let bodyHtml = '';
                  if (rowsData.length > 0) {
                      rowsData.forEach((row, index) => {
                          // Gunakan properti label langsung untuk nama tanaman
                          let jenisTanaman = row.label || 'Tidak Diketahui';
                          let nilai = '–';
                          
                          if (row.variables && row.variables[variabelKey] && row.variables[variabelKey].value !== undefined) {
                              nilai = row.variables[variabelKey].value;
                          }
                          
                          let nilaiTampil = (nilai === '-' || nilai === null || nilai === '...') ? '–' : nilai;
                          
                          bodyHtml += `<tr>`;
                          bodyHtml += `<td class="text-center">${index + 1}</td>`;
                          bodyHtml += `<td class="fw-bold text-navy">${jenisTanaman}</td>`;
                          bodyHtml += `<td class="text-end">${nilaiTampil}</td>`;
                          bodyHtml += `</tr>`;
                      });
                  } else {
                      bodyHtml = `<tr><td colspan="3" class="text-center text-secondary py-4">Data perkebunan tidak ditemukan pada tahun ${tahunTerpilih}.</td></tr>`;
                  }
                  $('#bps-tbody').html(bodyHtml);

                  // 4. Sembunyikan Loading & Tampilkan Tabel
                  $('#loading-state').addClass('d-none');
                  $('#table-container').removeClass('d-none');

                  // 5. Inisialisasi DataTables
                  $('#bps-table').DataTable({
                      dom: 'Bfrtip',
                      buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                      pageLength: 25, // Diubah ke 25 agar seluruh varietas komoditas langsung terlihat tanpa terpotong paging awal
                      responsive: true, 
                      ordering: true,
                      language: {
                          url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json"
                      }
                  });

              } else {
                  showErrorState("Format respons data API BPS tidak sesuai atau kosong.");
              }
          })
          .catch(err => {
              console.error(err);
              showErrorState("Gagal memuat data dari API BPS. Pastikan key benar dan tidak ada kendala CORS.");
          });
  }

  function showErrorState(message) {
      $('#loading-state').addClass('d-none');
      $('#tabel-judul').text('Gagal Memuat Data');
      $('#table-container').removeClass('d-none');
      $('#bps-thead').html('<tr><th>Status</th></tr>');
      $('#bps-tbody').html(`<tr><td class="text-center text-danger py-4"><i class="fa-solid fa-circle-exclamation me-2"></i> ${message}</td></tr>`);
  }
</script>

<%- include('../../../partials/_foot_admin.ejs') %>