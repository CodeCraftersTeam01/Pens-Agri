<%- include('../../partials/_head_admin.ejs') %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<div class="container-fluid">
    <div class="row">
        <%- include('../../partials/_nav_admin.ejs') %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 p-0">
            <%- include('../../partials/_top_nav_admin.ejs') %>

            <div class="p-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-3">
                    <h1 class="h2 fw-bold text-navy">Data Sensor Lapangan</h1>
                    <button class="btn btn-sm btn-navy shadow-sm" onclick="window.location.reload();">
                        <i class="fa-solid fa-rotate me-1"></i> Refresh Data
                    </button>
                </div>
                <div class="card card-custom p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0 fw-semibold text-navy">Log Monitoring Lahan Terbaru</h5>
    </div>
    
    <div class="table-responsive">
        <table id="monitoringTable" class="table table-custom table-hover align-middle mb-0" style="font-size: 13px;">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Aksi</th>
                    <th>Wilayah (Desa)</th>
                    <th>Koordinat (Lat, Lon)</th>
                    <th>Komoditas</th>
                    <th>Luas / Status</th>
                    <th>Irigasi</th>
                    <th>Tadahan</th>
                    <th>Listrik</th>
                    <th>Pompa</th>
                    <th>Sumber Air</th>
                    <th>Kondisi Air</th> 
                    <th>Pembajak</th>
                    <th>Poktan</th>
                    <th>Gagal Panen</th>
                    <th>Suhu (°C)</th>
                    <th>Kelembapan (%)</th>
                    <th>pH</th>
                    <th>EC (us/cm)</th>
                    <th>N</th>
                    <th>P</th>
                    <th>K</th>
                    <th>Fertility</th>
                    <th>Waktu Input</th>
                </tr>
            </thead>
            <tbody>
                <% if (data && data.length > 0) { %>
                    <% for(var i = 0; i < data.length; i++) { %>
                        <tr>
                            <td>#<%= (i + 1) %></td>
                            <td>
                            
                                <a href="/sensor/delete/<%= data[i].id %>" class="btn btn-sm btn-danger"><i class="fa fa-trash" aria-hidden="true"></i></a></td>
                            <td class="fw-semibold text-navy"><%= data[i].nama_desa %></td>
                            <td>
                                <small class="font-monospace text-secondary">
                                    <%= data[i].latitude %>,<br><%= data[i].longitude %>
                                </small>
                            </td>
                            <td><span class="badge bg-success"><%= data[i].komoditas %></span></td>
                            <td>
                                <span class="text-navy fw-semibold"><%= data[i].luas_lahan %> Ha</span><br>
                                <small class="text-secondary">(<%= data[i].status_lahan %>)</small>
                            </td>
                            <td>
                                <span class="badge bg-opacity-10 <%= data[i].irigasi === 'ya' ? 'bg-success text-success border border-success' : 'bg-danger text-danger border border-danger' %>">
                                    <%= data[i].irigasi ? data[i].irigasi.toUpperCase() : '-' %>
                                </span>
                            </td>
                            <td><span class="text-secondary"><%= data[i].tadahan_hujan %></span></td>
                            <td>
                                <span class="badge <%= data[i].listrik === 'ya' ? 'bg-info text-dark' : 'bg-secondary' %>">
                                    <%= data[i].listrik %>
                                </span>
                            </td>
                            <td>
                                <span class="text-navy"><%= data[i].pompa_air %></span>
                                <% if(data[i].pompa_air === 'ya' && data[i].sumber_energi_pompa !== 'tida') { %>
                                    <br><small class="text-warning">(<%= data[i].sumber_energi_pompa %>)</small>
                                <% } %>
                            </td>
                            <td><span class="text-navy"><%= data[i].sumber_air %></span></td>
                            <td>
                                <span class="badge <%= data[i].kondisi_air === 'Sulit' ? 'bg-danger' : 'bg-success' %>">
                                    <%= data[i].kondisi_air %>
                                </span>
                            </td>
                            <td><span class="text-secondary"><%= data[i].pembajak %></span></td>
                            <td>
                                <span class="badge <%= data[i].kelompok_tani === 'ya' ? 'bg-primary' : 'bg-secondary' %>">
                                    <%= data[i].kelompok_tani %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= data[i].gagal_panen === 'ya' ? 'bg-danger' : 'bg-opacity-10 bg-success text-success' %>">
                                    <%= data[i].gagal_panen %>
                                </span>
                            </td>
                            <td class="text-warning fw-bold"><%= data[i].temp %></td>
                            <td class="text-info fw-bold"><%= data[i].moisture %></td>
                            <td class="fw-bold <%= data[i].ph < 6.0 ? 'text-danger' : 'text-success' %>"><%= data[i].ph %></td>
                            <td class="font-monospace text-muted"><%= data[i].conductivity %></td>
                            <td class="font-monospace text-success fw-bold"><%= data[i].nitrogen %></td>
                            <td class="font-monospace text-danger fw-bold"><%= data[i].phosphorus %></td>
                            <td class="font-monospace text-info fw-bold"><%= data[i].potassium %></td>
                            <td class="font-monospace text-secondary fw-bold"><%= data[i].fertility %></td>
                            <td>
                                <small class="text-secondary">
                                    <%= new Date(data[i].created_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %> WIB
                                </small>
                            </td>
                        </tr>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="24" class="text-center text-secondary py-4">
                            <i class="fa-solid fa-database me-2"></i> Belum ada data log kuesioner & sensor dari lapangan.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

            </div>
        </main>
    </div>
</div>

<script>
  $(document).ready(function() {
    $('#monitoringTable').DataTable({
    select:true,
      dom: 'Bfrtip',
      buttons: [
        'colvis', // <-- Fitur untuk memilih kolom yang ingin disembunyikan/ditampilkan
        'copy', 
        'csv', 
        'excel', 
        'pdf', 
        'print'
      ],
      pageLength: 10,
      responsive: true,
      ordering: true,
      language: {
        url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/id.json",
        buttons: {
          colvis: "Pilih Kolom" // Mengubah teks tombol ColVis menjadi bahasa Indonesia
        }
      }
    });
  });
</script>
<!-- JS DataTables Buttons & ColVis -->
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>
<%- include('../../partials/_foot_admin.ejs') %>