<%- include('../partials/_head_admin.ejs') %>

<style>
    /* Super Admin-specific badge */
    .sa-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 700;
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
        padding: 4px 12px;
        border-radius: 99px;
    }
</style>

<div style="display: flex; min-height: 100vh;">

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<nav class="sidebar" id="mainSidebar">
    <!-- Brand -->
    <div class="d-flex justify-content-between align-items-center w-100 pe-2">
        <a href="/superusers" class="sidebar-brand flex-grow-1 border-0">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-leaf"></i>
            </div>
            <div class="sidebar-brand-text">
                <span class="sidebar-brand-name">PENS Agri</span>
                <span class="sidebar-brand-sub">Super Admin</span>
            </div>
        </a>
        <button class="sidebar-close-btn d-lg-none" id="sidebarCloseBtn" aria-label="Tutup Menu">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="sidebar-nav">
        <div class="sidebar-section-label">Administrasi</div>
        <a class="sidebar-link active" href="/superusers">
            <i class="fa-solid fa-gauge link-icon"></i>
            Overview
        </a>
        <a class="sidebar-link" href="/users">
            <i class="fa-solid fa-chart-pie link-icon"></i>
            Dashboard User
        </a>

        <div class="sidebar-section-label">Sistem Presisi</div>
        <a class="sidebar-link" href="/petalahan">
            <i class="fa-solid fa-map link-icon"></i>
            Peta Lahan
        </a>
        <a class="sidebar-link" href="/sensor">
            <i class="fa-solid fa-microchip link-icon"></i>
            Data Sensor
        </a>
        <a class="sidebar-link" href="/policy_brief">
            <i class="fa-solid fa-brain link-icon"></i>
            AI Policy Brief
        </a>
    </div>
</nav>

<!-- Main Content -->
<div class="main-content">
    <!-- Top Nav -->
    <header class="topnav">
        <div class="topnav-left">
            <button class="btn-sidebar-toggle d-lg-none me-2" id="sidebarToggle" aria-label="Toggle Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div>
                <div class="topnav-title">Panel Administrasi</div>
                <div class="topnav-sub">PENS Agri Presisi · Super User Access</div>
            </div>
        </div>
        <div class="topnav-right">
            <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Server aktif</span>
            </div>
            <div class="dropdown">
                <button class="btn-secondary dropdown-toggle" data-bs-toggle="dropdown" style="font-size:13.5px; gap: 8px; padding: 7px 14px; border-radius: 10px;">
                    <div class="avatar" style="width:28px;height:28px;font-size:12px; background: #0b1c33;">
                        <i class="fa-solid fa-user" style="font-size:12px;"></i>
                    </div>
                    <span class="fw-semibold d-none d-sm-inline"><%= typeof email !== 'undefined' ? email.split('@')[0] : 'Super Admin' %></span>
                </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 220px; padding: 10px; border-radius: 14px;">
                        <li class="px-2 py-1.5">
                            <div style="font-size:11px;color:var(--color-text-secondary);font-weight:700;text-transform:uppercase;letter-spacing:.05em;">Masuk sebagai</div>
                            <div style="font-size:13.5px;font-weight:700; color: var(--color-text-primary); margin-top: 2px;"><%= typeof email !== 'undefined' ? email : 'superadmin@pens-agri.ac.id' %></div>
                        </li>
                        <li><hr class="dropdown-divider my-2"></li>
                        <li><a class="dropdown-item py-2" href="/superusers"><i class="fa-solid fa-shield-halved me-2 text-warning"></i> Super Admin</a></li>
                        <li><a class="dropdown-item py-2" href="/users"><i class="fa-solid fa-gauge me-2 text-primary"></i> Dashboard User</a></li>
                        <li><hr class="dropdown-divider my-2"></li>
                        <li><a class="dropdown-item text-danger py-2" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Keluar</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Body -->
        <div class="page-content-wrapper">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                        <h1 class="page-header-title">Panel Super Administrator</h1>
                        <span class="sa-role-badge">
                            <i class="fa-solid fa-shield-halved" style="font-size:10px;"></i>
                            Super User
                        </span>
                    </div>
                    <p style="font-size: 13.5px; color: var(--color-text-secondary); margin: 0;">
                        Akses kendali penuh terhadap konfigurasi sistem, data sensor USB lapangan, dan analitik AI.
                    </p>
                </div>
                <a href="/users" class="btn-primary-accent">
                    <i class="fa-solid fa-house"></i>
                    Buka Dashboard User
                </a>
            </div>

            <!-- Stat Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="stat-label">Total Titik Lahan</div>
                            <div class="stat-icon" style="background: #eff6ff; color: #2563eb;">
                                <i class="fa-solid fa-map-location-dot"></i>
                            </div>
                        </div>
                        <div class="stat-value">641</div>
                        <span class="stat-badge green"><i class="fa-solid fa-check me-1"></i> Terdata 100%</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="stat-label">Metode Pengujian</div>
                            <div class="stat-icon" style="background: #f0fdf4; color: #16a34a;">
                                <i class="fa-solid fa-microchip"></i>
                            </div>
                        </div>
                        <div class="stat-value">USB Dongle</div>
                        <span class="stat-badge green"><i class="fa-solid fa-mobile-screen me-1"></i> Sensor OTG Mobile</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="stat-label">Rata-Rata pH Tanah</div>
                            <div class="stat-icon" style="background: #fffbeb; color: #f59e0b;">
                                <i class="fa-solid fa-flask"></i>
                            </div>
                        </div>
                        <div class="stat-value">7.04</div>
                        <span class="stat-badge amber">Netral · Optimal</span>
                    </div>
                </div>
            </div>

            <!-- Quick Access Menu & System Controls Row -->
            <div class="row g-4 mb-4">
                <div class="col-lg-7">
                    <div class="card p-4 h-100">
                        <div class="section-title mb-1">Akses Cepat Modul Sistem</div>
                        <div class="section-sub mb-3">Navigasi langsung ke seluruh pilar platform PENS Agri</div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="/policy_brief" style="text-decoration: none;">
                                    <div class="stat-card h-100" style="cursor: pointer; border: 1px solid rgba(226, 232, 240, 0.9);">
                                        <div class="stat-icon mb-2" style="background: #f5f3ff; color: #7c3aed; width: 38px; height: 38px; font-size: 16px;">
                                            <i class="fa-solid fa-brain"></i>
                                        </div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 14px;">AI Policy Brief</div>
                                        <div class="text-muted" style="font-size: 12px; line-height: 1.4;">Formulasi kebijakan berbasis AI & BPS</div>
                                        <div class="text-primary fw-semibold mt-2" style="font-size: 12px;">
                                            Buka <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="/petalahan" style="text-decoration: none;">
                                    <div class="stat-card h-100" style="cursor: pointer; border: 1px solid rgba(226, 232, 240, 0.9);">
                                        <div class="stat-icon mb-2" style="background: #ecfeff; color: #06b6d4; width: 38px; height: 38px; font-size: 16px;">
                                            <i class="fa-solid fa-map"></i>
                                        </div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 14px;">Peta Lahan Geospasial</div>
                                        <div class="text-muted" style="font-size: 12px; line-height: 1.4;">Sebaran koordinat lahan & data sensor</div>
                                        <div class="text-primary fw-semibold mt-2" style="font-size: 12px;">
                                            Buka <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="/sensor" style="text-decoration: none;">
                                    <div class="stat-card h-100" style="cursor: pointer; border: 1px solid rgba(226, 232, 240, 0.9);">
                                        <div class="stat-icon mb-2" style="background: #f0fdf4; color: #16a34a; width: 38px; height: 38px; font-size: 16px;">
                                            <i class="fa-solid fa-microchip"></i>
                                        </div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 14px;">Data Sensor Lapangan</div>
                                        <div class="text-muted" style="font-size: 12px; line-height: 1.4;">Log uji tanah NPK & pH via USB HP</div>
                                        <div class="text-primary fw-semibold mt-2" style="font-size: 12px;">
                                            Buka <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="/kelompoktani" style="text-decoration: none;">
                                    <div class="stat-card h-100" style="cursor: pointer; border: 1px solid rgba(226, 232, 240, 0.9);">
                                        <div class="stat-icon mb-2" style="background: #fffbeb; color: #f59e0b; width: 38px; height: 38px; font-size: 16px;">
                                            <i class="fa-solid fa-users"></i>
                                        </div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 14px;">Kelompok Tani</div>
                                        <div class="text-muted" style="font-size: 12px; line-height: 1.4;">Data poktan & kelembagaan</div>
                                        <div class="text-primary fw-semibold mt-2" style="font-size: 12px;">
                                            Buka <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Setting Control Panel -->
                <div class="col-lg-5">
                    <div class="card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="section-title">Pengaturan Sistem & Hak Akses</div>
                                <div class="section-sub">Konfigurasi operasional telemetri</div>
                            </div>
                            <span class="pill green"><i class="fa-solid fa-shield-check me-1"></i> Aman</span>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            <div class="p-2.5 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 12.5px;">Akses Terbuka Anggota Poktan</div>
                                    <div class="text-muted" style="font-size: 11px;">Hak baca data telemetri bagi anggota</div>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" checked>
                                </div>
                            </div>

                            <div class="p-2.5 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 12.5px;">Notifikasi Sensor Realtime</div>
                                    <div class="text-muted" style="font-size: 11px;">Peringatan otomatis ambang batas hara</div>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" checked>
                                </div>
                            </div>

                            <div class="p-2.5 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 12.5px;">AI Policy Auto-Sync</div>
                                    <div class="text-muted" style="font-size: 11px;">Sinkronisasi dataset BPS secara berkala</div>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" checked>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Info -->
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="section-title">Informasi Lingkungan Sistem</div>
                        <div class="section-sub">Status server dan platform telemetri</div>
                    </div>
                    <span class="stat-badge green"><span class="status-dot me-1"></span> Operational</span>
                </div>

                <div class="row g-3">
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <div class="stat-label mb-1">Platform</div>
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">PENS Agri Presisi v2.0</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <div class="stat-label mb-1">Institusi</div>
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">PENS Surabaya</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <div class="stat-label mb-1">Wilayah</div>
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">Kab. Sumenep, Madura</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <div class="stat-label mb-1">Otoritas</div>
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">Super Administrator</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/_foot_admin.ejs') %>