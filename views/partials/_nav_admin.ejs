<style>
    /* Style untuk link sub-menu */
.sidebar .sub-nav-link {
    color: #b3c6d8;
    padding: 8px 15px;
    margin: 2px 10px;
    font-size: 13.5px;
    font-weight: 400;
    border-radius: 6px;
}

.sidebar .sub-nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
}

/* Kategori sub-menu saat aktif */
.sidebar .sub-nav-link.sub-active {
    color: #ffcc00 !important; /* Teks sub-menu menjadi kuning emas */
    font-weight: 600;
    background-color: transparent; /* Tetap transparan agar tidak nabrak menu utama */
}

/* Animasi putar ikon panah dropdown */
.dropdown-arrow {
    transition: transform 0.2s ease;
}
.sidebar .nav-link[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg);
}
</style>
<nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
    <div class="position-sticky pt-3">
        <div class="px-4 py-3 d-flex align-items-center">
            <i class="fa-solid fa-leaf text-yellow fs-3 me-2"></i> 
            <span class="fs-5 fw-bold text-white tracking-wide">PENS AGRI</span>
        </div>
        <hr class="text-secondary mx-3" style="opacity: 0.15;">
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/users') ? 'active' : '' %>" href="/users">
                    <i class="fa-solid fa-chart-pie me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/policy_brief') ? 'active' : '' %>" href="/policy_brief">
                    <i class="fa-solid fa-chart-pie me-2"></i> Rekomendasi Kebijakan
                </a>
            </li>
            
            <li class="nav-item">
                <a class="nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/petalahan') ? 'active' : '' %>" href="/petalahan">
                    <i class="fa-solid fa-map-location-dot me-2"></i> Pemetaan Lahan
                </a>
            </li>
            
            <li class="nav-item">
                <a class="nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/sensor') ? 'active' : '' %>" href="/sensor">
                    <i class="fa-solid fa-database me-2"></i> Data Sensor
                </a>
            </li>
            
            <li class="nav-item">
                <% 
                    // Logika pengecekan apakah salah satu sub-menu sedang diakses
                    var isMasterActive = (typeof currentRoute !== 'undefined' && (currentRoute === '/kelompoktani' || currentRoute === '/masterlahan' || currentRoute === '/komoditas'));
                %>
                <a class="nav-link d-flex justify-content-between align-items-center <%= isMasterActive ? 'active' : '' %>" 
                   data-bs-toggle="collapse" 
                   href="#masterDataDropdown" 
                   role="button" 
                   aria-expanded="<%= isMasterActive ? 'true' : 'false' %>">
                    <div>
                        <i class="fa-solid fa-layer-group me-2"></i> Master Pertanian
                    </div>
                    <i class="fa-solid fa-chevron-down small dropdown-arrow <%= isMasterActive ? 'rotate' : '' %>"></i>
                </a>
                
                <div class="collapse <%= isMasterActive ? 'show' : '' %>" id="masterDataDropdown">
                    <ul class="nav flex-column ms-3 ps-2" style="border-left: 1px solid rgba(255, 255, 255, 0.1);">
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/kelompoktani') ? 'sub-active' : '' %>" href="/kelompoktani">
                                <i class="fa-solid fa-users me-2 small"></i> Kelompok Tani
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/sayur_buah') ? 'sub-active' : '' %>" href="/sayur_buah">
                                <i class="fa-solid fa-mountain-sun me-2 small"></i> Statistik Sayur & Buah
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/luas_panen_sayur_buah') ? 'sub-active' : '' %>" href="/sayur_buah/luas_panen">
                                <i class="fa-solid fa-mountain-sun me-2 small"></i> Statistik Luas Panen Sayur & Buah
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/biofarmaka') ? 'sub-active' : '' %>" href="/biofarmaka">
                                <i class="fa-solid fa-mountain-sun me-2 small"></i> Statistik Biofarmaka
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/luas_panen_biofarmaka') ? 'sub-active' : '' %>" href="/biofarmaka/luas_panen">
                                <i class="fa-solid fa-mountain-sun me-2 small"></i> Statistik Luas Panen Biofarmaka
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sub-nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/luas_tanam_perkebunan_rakyat') ? 'sub-active' : '' %>" href="/luas_tanam_perkebunan_rakyat">
                                <i class="fa-solid fa-mountain-sun me-2 small"></i> Statistik Luas Tanam Perkebunan Rakyat
                            </a>
                        </li>
                    </li>
                </ul>
            </div>
            
            <li class="nav-item">
                <a class="nav-link <%= (typeof currentRoute !== 'undefined' && currentRoute === '/pengaturan') ? 'active' : '' %>" href="/pengaturan">
                    <i class="fa-solid fa-gears me-2"></i> Pengaturan
                </a>
            </li>
        </ul>
    </div>
</nav>